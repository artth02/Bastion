{
  "name": "bastion-api",
  "version": "3.0.3",
  "description": "A Real Time Notification API",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "test": "npm run lint && nyc npm run test-mocha",
    "test-mocha": "cross-env NODE_ENV=test mocha --exit \"./libs/**/*Spec.js\"",
    "test-mocha-watch": "cross-env NODE_ENV=test mocha --watch \"./libs/**/*Spec.js\"",
    "lint": "standard --verbose | snazzy",
    "lint:fix": "standard --fix",
    "lintdiff": "git diff --name-only --cached --relative | grep '\\.js$' | xargs standard | snazzy",
    "coverage": "cross-env NODE_ENV=test nyc report --reporter=text-lcov | coveralls"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/artth02/bastion.git"
  },
  "keywords": [
    "nodejs",
    "api"
  ],
  "engines": {
    "node": ">=26",
    "npm": ">=11"
  },
  "author": "Arthur R. Fonseca",
  "license": "",
  "dependencies": {
    "@aws-sdk/client-sns": "^3.1156.0",
    "@faker-js/faker": "^10.6.0",
    "@hapi/hapi": "^21.4.11",
    "@hapi/inert": "^7.1.3",
    "@hapi/vision": "^7.0.3",
    "config": "^5.0.1",
    "hapi-swagger": "^17.3.2",
    "joi": "^17.13.8",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "ws": "^8.22.0"
  },
  "standard": {
    "ignore": [
      "libs/test/package/",
      "site/"
    ],
    "globals": [
      "describe",
      "it",
      "test",
      "socketIO",
      "socketClient",
      "connectedClients",
      "wsServer"
    ]
  },
  "nyc": {
    "include": [
      "libs/**/*.js"
    ],
    "exclude": [
      "libs/test/**"
    ],
    "all": false
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "mocha": "^12.0.3",
    "nyc": "^18.0.0",
    "snazzy": "^9.0.0",
    "standard": "^17.1.2"
  }
}
